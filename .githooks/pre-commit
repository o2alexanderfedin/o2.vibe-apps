#!/bin/sh
# git-flow enforcement: no direct commits to long-lived branches.
branch=$(git rev-parse --abbrev-ref HEAD)
# A merge in progress is git-flow finishing a branch. A clean merge never runs
# this hook; a conflicted one stops, and its resolution is committed with
# `git commit`, which does. Rejecting that commit would leave the branch stuck
# mid-merge with --no-verify as the only way out.
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi
if [ "$branch" = "main" ] || [ "$branch" = "develop" ]; then
  echo "✖ Direct commits to '$branch' are blocked. Work on a feature branch (e.g. git flow feature start <name>) and merge."
  exit 1
fi
exit 0
